# Keep the build context small and dev artifacts out of the image.
# Guards the `COPY data ./data` in the Dockerfile: only the tracked CSV
# underlag ships — never a local development database.
.git
.venv
__pycache__
*.pyc
.pytest_cache
.env
data/*.db
data/*.db-wal
data/*.db-shm
# Datakatalogen för fristående drift — driftdatabasen ska aldrig in i imagen
# (och ägs av uid 1505, så bygget skulle inte kunna läsa den).
teaball-data
