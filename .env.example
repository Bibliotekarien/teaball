# Kopiera till .env och fyll i. SECRET_KEY signerar sessionscookies —
# generera med: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# I produktion (COOKIE_SECURE=1) vägrar appen starta utan riktig nyckel.
SECRET_KEY=

# Publik bas-URL — används när medlemmarnas svarslänkar skapas.
PUBLIC_BASE_URL=https://teaball.example.org

# Instansens texter. Tomma värden ger neutral text.
# ORGANISATION: organisationen/samarbetet, visas på integritetssidan.
# NUVARANDE_SYSTEM: systemet som ersätts, används i statusen "utreds".
ORGANISATION=
NUVARANDE_SYSTEM=

# Integritetssidan (/integritet). Saknas de visar sidan en gul markering om
# att de ska fyllas i före skarp drift.
PERSONUPPGIFTSANSVARIG=
DATASKYDD_KONTAKT=

# Anubis (endast docker-compose.prod.yml): måste matcha det publika hostnamnet,
# annars accepteras inte clearance-cookien.
ANUBIS_COOKIE_DOMAIN=teaball.example.org

# Server-side Matomo (Tracking HTTP API) — tomma värden stänger av trackingen.
# URL:en till er Matomo och sajtens site-id därifrån
# (Administration → Websites → Manage → Add a new website).
# MATOMO_TOKEN (token_auth) behövs för att skicka besökarens riktiga IP (cip).
MATOMO_URL=
MATOMO_SITE_ID=
MATOMO_TOKEN=

# Lokal utveckling utan Docker: sökväg till databasfilen (lokal disk, aldrig CIFS).
# I docker-compose sätts DB_PATH till /data/teaball.db av compose-filen.
#DB_PATH=./data/teaball.db
#COOKIE_SECURE=0
