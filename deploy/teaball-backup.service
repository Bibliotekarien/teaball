# Engångsjobb som körs av teaball-backup.timer.
# Installera: sudo cp deploy/teaball-backup.{service,timer} /etc/systemd/system/
#             sudo systemctl daemon-reload && sudo systemctl enable --now teaball-backup.timer
#
# Tar en konsistent kopia av varje organisations SQLite-fil i named-volymen
# (spec I4: .backup-API, integritetskontroll, utrymmeskoll, rotation 30
# dagliga + 12 månatliga), i /opt/teaball/backups/<hostnamn>/. Misslyckas en
# organisation misslyckas jobbet, och då avbryts också deploy.sh.
#
# Körs som teaball (uid 1505), samma användare som containern, inte som root.
# Datakatalogen är skrivbar för containern; root ska inte öppna en databas
# som en komprometterad container har kunnat preparera. Den enda förmåga
# jobbet behöver utöver det är att ta sig igenom /var/lib/docker (root-only):
# CAP_DAC_READ_SEARCH, som bara ger läsning. Skrivbart är enbart målet och
# datakatalogen (SQLite kan behöva röra -shm-filen när WAL används).
#
# Backupkatalogen måste ägas av teaball:
#   sudo install -d -o teaball -g teaball -m 700 /opt/teaball/backups
#   sudo chown -R teaball:teaball /opt/teaball/backups   # befintliga kopior

[Unit]
Description=teaball SQLite backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=teaball
Group=teaball
UMask=0077
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/teaball/backups /var/lib/docker/volumes/teaball_teaball-data/_data
ExecStart=/opt/teaball/app/scripts/backup_alla.sh \
    /var/lib/docker/volumes/teaball_teaball-data/_data/organisationer \
    /opt/teaball/backups
